gen_unit_stmt_term: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_unit_stmt_t);

    gen.visit(&obj.body);

    gen.add_data(k_identifier, &"voidc_internal_make_unit_stmt_term");
}


//---------------------------------------------------------------------
//- stmt list
//---------------------------------------------------------------------
export
voidc_internal_make_stmt_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - size;

    ret  = (ast: *v_ast_stmt_list_t);
    stmt = (ast: *v_ast_stmt_t);

    if (size) v_make_list(ret, stmt, size);
    else      v_make_list_nil(ret);

    top := ret + 1;

    cmd += 1;
}

export
voidc_internal_append_stmt_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - (size + 1);

    ret  = (ast   : *v_ast_stmt_list_t);
    stmt = (ast+1 : *v_ast_stmt_t);

    v_list_append(ret, ret, stmt, size);

    top := ret + 1;

    cmd += 1;
}

private
gen_stmt_list: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    lst = (self: *v_ast_stmt_list_t);

    size = v_list_get_size(lst);

    M = 32;         //- ?

    for (i: &size_t := 0;;)
    {
        n: &size_t := undef;

        if (m = size - i, m < M)  n := m;
        else                      n := M;

        for (s = i+n; i < s; ++i)
        {
            gen.visit(v_list_get_item(lst, i));
        }

        if (i == n)
        {
            gen.pop_n((n - 1 : int));

            gen.add_data(k_identifier, &"voidc_internal_make_stmt_list");
            gen.add_data(k_number,     (n: *void));
        }
        else
        {
            gen.pop_n((n: int));

            gen.add_data(k_identifier, &"voidc_internal_append_stmt_list");
            gen.add_data(k_number,     (n: *void));
        }

        if (i == size)  break;
    }
}


//---------------------------------------------------------------------
//- stmt
//---------------------------------------------------------------------
export
voidc_internal_make_stmt: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    qname = v_quark_from_string((cmd[0] : *const char));

    ast = top - 1;

    ret  = (ast: *v_ast_stmt_t);
    expr = (ast: *v_ast_expr_t);

    v_ast_make_stmt_q(ret, qname, expr);

    cmd += 1;
}

private
gen_stmt: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    stm = (self: *v_ast_stmt_t);

    qname = v_ast_stmt_get_name_q(stm);
    sexpr = v_ast_stmt_get_expr(stm);

    gen.visit(sexpr);

    gen.add_data(k_identifier, &"voidc_internal_make_stmt");
    gen.add_data(k_quark,      (qname: *void));
}


//---------------------------------------------------------------------
//- stmt if_then_else
//---------------------------------------------------------------------
export
voidc_internal_make_stmt_if_then_else: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 3;

    ret  = (ast:   *v_ast_stmt_t);
    cond = (ast+0: *v_ast_expr_t);
    then = (ast+1: *v_ast_stmt_t);
    else = (ast+2: *v_ast_stmt_t);

    v_ast_make_stmt_if_then_else(ret, cond, then, else);

    top -= 2;
}

private
gen_stmt_if_then_else: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_stmt_if_then_else_t);

    cond = &obj[0];
    then = &obj[1];
    else = &obj[2];

    gen.visit(cond);
    gen.visit(then);
    gen.visit(else);

    gen.pop_n(2);

    gen.add_data(k_identifier, &"voidc_internal_make_stmt_if_then_else");
}


//---------------------------------------------------------------------
//- stmt block
//---------------------------------------------------------------------
export
voidc_internal_make_stmt_block: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    flag = (cmd[0] : bool);

    ast = top - 1;

    ret  = (ast: *v_ast_stmt_t);
    body = (ast: *v_ast_stmt_list_t);

    v_ast_make_stmt_block(ret, body, flag);

    cmd += 1;
}

private
gen_stmt_block: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_stmt_block_t);

    body = &obj[0];
    flag = obj[1];

    gen.visit(body);

    gen.add_data(k_identifier, &"voidc_internal_make_stmt_block");
    gen.add_data(k_number,     (flag: *void));
}


//---------------------------------------------------------------------
//- stmt loop
//---------------------------------------------------------------------
export
voidc_internal_make_stmt_loop: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 1;

    ret  = (ast: *v_ast_stmt_t);

{   voidc_guard_target("generating_ast.void  must be imported into the voidc target only!");

    v_import("level-00");
    v_import("level-01");
    v_import("level-02");

    v_import("intrinsics_derive.void");
    v_import("local_objects.void");
    v_import("heap_objects.void");
    v_import("global_objects.void");
    v_import("coercions.void");
    v_import("namespaces.void");
    v_import("generics_etc.void");

    v_import("llvm-c/Core.void");

//  v_import("printf.void");
}

{   v_enable_level_01();
    v_enable_level_02();

    voidc_enable_intrinsics_derive();
    voidc_enable_local_objects();
    voidc_enable_heap_objects();
    voidc_enable_global_objects();
    voidc_enable_coercions();
    voidc_enable_namespaces();
    voidc_enable_generics_etc();
}


//---------------------------------------------------------------------
{   q_ref = v_reference_type(v_quark_t, 0);

    q = v_quark_ptr_from_string;

    v_add_symbol("enabled_q", q_ref, q("voidc.internal.generating_ast_enabled"));
}


//=====================================================================
{   voidc_unit_begin_module("generating_ast_module"); }


//---------------------------------------------------------------------
{ v_set_export_flag(true); }


//---------------------------------------------------------------------
struct voidc_ast_generator_t
{
    visitor: voidc_visitor_t;           //- Kinda, "base class"...

    //---------------------------------------------------------
    data_list: v_util_list_t;

    max_stk: int;
    cur_stk: int;
};


//---------------------------------------------------------------------
(v_initialize(_)): (d: *voidc_ast_generator_t) ~> void
{
    v_initialize(&d->visitor);

    v_get_ast_generator_visitor: () ~> *voidc_visitor_t;

    v_copy(&d->visitor, v_get_ast_generator_visitor());

    v_initialize(&d->data_list);

    v_make_list_nil(&d->data_list);

    d->max_stk := 0;
    d->cur_stk := 0;
}

(v_terminate(_)): (*voidc_ast_generator_t) ~> void  =  derive;


//---------------------------------------------------------------------
private
(_.add_data()): (gen: &voidc_ast_generator_t, key: unsigned, data: *void) ~> void
{
    list = &gen.data_list;

    a: &v_std_any_t := {};

    v_std_any_set_value(&a, (key: intptr_t));   v_list_append(list, list, &a);
    v_std_any_set_value(&a, (data: intptr_t));  v_list_append(list, list, &a);
}

//---------------------------------------------------------------------
private
(_.push): (gen: &voidc_ast_generator_t) ~> void
{
    r: int = ++gen.cur_stk;

    if (gen.max_stk < r)  gen.max_stk := r;
}

private
(_.pop): (gen: &voidc_ast_generator_t) ~> void
{
    v_assert(gen.cur_stk > 0);

    --gen.cur_stk;
}

private
(_.pop_n()): (gen: &voidc_ast_generator_t, n: int) ~> void
{
    v_assert(gen.cur_stk >= n);

    gen.cur_stk -= n;

    if (n < 0  &&  gen.max_stk < gen.cur_stk)  gen.max_stk := gen.cur_stk;
}


//---------------------------------------------------------------------
//- Generating methods ...
//---------------------------------------------------------------------
{ v_set_export_flag(false); }


//---------------------------------------------------------------------
k_identifier: unsigned = 0;
k_number:     unsigned = 1;
k_quark:      unsigned = 2;
k_string:     unsigned = 3;

//---------------------------------------------------------------------
export
voidc_internal_make_empty: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    v_terminate(top);
    v_initialize(top);

    ++top;
}

(_.visit()): (gen: &voidc_ast_generator_t, ast: *v_ast_base_t) ~> void
{
    if (v_empty(ast))
    {
        gen.push;

        gen.add_data(k_identifier, &"voidc_internal_make_empty");
    }
    else
    {
        v_ast_accept_visitor(ast, &gen.visitor);
    }
}


//---------------------------------------------------------------------
//- unit
//---------------------------------------------------------------------
export
voidc_internal_make_unit: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    line   = (cmd[0] : int);
    column = (cmd[1] : int);

    ast = top - 1;

    ret  = (ast: *v_ast_unit_t);
    list = (ast: *v_ast_stmt_list_t);

    v_ast_make_unit(ret, list, line, column);

    cmd += 2;
}

private
gen_unit: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    unit = (self: *v_ast_unit_t);

    list   = v_ast_unit_get_stmt_list(unit);
    line   = v_ast_unit_get_line(unit);
    column = v_ast_unit_get_column(unit);

    gen = *(vis: *voidc_ast_generator_t);

    gen.visit(list);

    gen.add_data(k_identifier, &"voidc_internal_make_unit");
    gen.add_data(k_number,     (line  : *void));
    gen.add_data(k_number,     (column: *void));
}


//---------------------------------------------------------------------
//- generic list
//---------------------------------------------------------------------
export
voidc_internal_make_generic_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size  = (cmd[0] : size_t);
    quark = v_quark_from_string((cmd[1] : *const char));

    ast = top - size;

    ret = (ast: *v_ast_generic_list_t);

    if (size) v_make_list(ret, quark, ast, size);
    else      v_make_list_nil(ret, quark);

    top := ret + 1;

    cmd += 2;
}

export
voidc_internal_append_generic_list: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    size = (cmd[0] : size_t);

    ast = top - (size + 1);

    ret = (ast: *v_ast_generic_list_t);

    v_list_append(ret, ret, ast+1, size);

    top := ret + 1;

    cmd += 1;
}

private
gen_generic_list: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    quark = v_ast_base_get_tag(self);

    lst = (self: *v_ast_generic_list_t);

    size = v_list_get_size(lst);

    M = 32;         //- ?

    for (i: &size_t := 0;;)
    {
        n: &size_t := undef;

        if (m = size - i, m < M)  n := m;
        else                      n := M;

        for (s = i+n; i < s; ++i)
        {
            gen.visit(v_list_get_item(lst, i));
        }

        if (i == n)
        {
            gen.pop_n((n - 1 : int));

            gen.add_data(k_identifier, &"voidc_internal_make_generic_list");
            gen.add_data(k_number,     (n: *void));
            gen.add_data(k_quark,      (quark: *void));
        }
        else
        {
            gen.pop_n((n: int));

            gen.add_data(k_identifier, &"voidc_internal_append_generic_list");
            gen.add_data(k_number,     (n: *void));
        }

        if (i == size)  break;
    }
}


//---------------------------------------------------------------------
//- unit_stmt_init
//---------------------------------------------------------------------
export
voidc_internal_make_unit_stmt_init: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 1;

    ret  =  ast;
    stmt = (ast: *v_ast_stmt_t);

    v_ast_make_unit_stmt_init(ret, stmt);
}

private
gen_unit_stmt_init: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_unit_stmt_t);

    gen.visit(&obj.body);

    gen.add_data(k_identifier, &"voidc_internal_make_unit_stmt_init");
}



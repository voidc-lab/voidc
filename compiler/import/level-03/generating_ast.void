//---------------------------------------------------------------------
//- stmt switch
//---------------------------------------------------------------------
export
voidc_internal_make_stmt_switch: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret = (ast:   *v_ast_stmt_t);
    arg = (ast:   *v_ast_expr_t);
    lst = (ast+1: *v_ast_generic_list_t);

    v_ast_make_stmt_switch(ret, arg, lst);

    top -= 1;
}

private
gen_stmt_switch: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_stmt_switch_t);

    arg = &obj[0];
    lst = &obj[1];

    gen.visit(arg);
    gen.visit(lst);

    gen.pop;

    gen.add_data(k_identifier, &"voidc_internal_make_stmt_switch");
}


//---------------------------------------------------------------------
//- case block
//---------------------------------------------------------------------
export
voidc_internal_make_case_block: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret =  ast;
    arg = (ast+0: *v_ast_expr_list_t);
    lst = (ast+1: *v_ast_stmt_list_t);

    v_ast_make_case_block(ret, arg, lst);

    top -= 1;
}

private
gen_case_block: (aux: *void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_case_block_t);

    arg = &obj[0];
    lst = &obj[1];

    gen.visit(arg);
    gen.visit(lst);

    gen.pop;

    gen.add_data(k_identifier, &"voidc_internal_make_case_block");
}



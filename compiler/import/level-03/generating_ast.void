//---------------------------------------------------------------------
//- expr call
//---------------------------------------------------------------------
export
voidc_internal_make_expr_call: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret = (ast:   *v_ast_expr_t);
    fun = (ast+0: *v_ast_expr_t);
    lst = (ast+1: *v_ast_expr_list_t);

    v_ast_make_expr_call(ret, fun, lst);

    top -= 1;
}

private
gen_expr_call: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    call = (self: *v_ast_expr_t);

    fun = v_ast_expr_call_get_fun_expr(call);
    lst = v_ast_expr_call_get_arg_list(call);

    gen.visit(fun);
    gen.visit(lst);

    gen.pop;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_call");
}


//---------------------------------------------------------------------
//- expr identifier
//---------------------------------------------------------------------
export
voidc_internal_make_expr_identifier: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    qn = v_quark_from_string((cmd[0] : *const char));

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_identifier_q(ret, qn);

    cmd += 1;
    top += 1;
}

private
gen_expr_identifier: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    eid = (self: *v_ast_expr_t);

    qn = v_ast_expr_identifier_get_name_q(eid);

    gen.push;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_identifier");
    gen.add_data(k_quark,      (qn: *void));
}


//---------------------------------------------------------------------
//- expr integer
//---------------------------------------------------------------------
export
voidc_internal_make_expr_integer: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    num = (cmd[0] : intptr_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_integer(ret, num);

    cmd += 1;
    top += 1;
}

private
gen_expr_integer: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    enum = (self: *v_ast_expr_t);

    num = v_ast_expr_integer_get_number(enum);

    gen.push;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_integer");
    gen.add_data(k_number,     (num: *void));
}


//---------------------------------------------------------------------
//- expr string
//---------------------------------------------------------------------
export
voidc_internal_make_expr_string: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    str = (cmd[0] : *const char);
    len = (cmd[1] : size_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_ast_make_expr_string_data(ret, str, len);

    cmd += 2;
    top += 1;
}

private
gen_expr_string: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    estr = (self: *v_ast_expr_t);

    len: &size_t := undef;

    str = v_ast_expr_string_get_string_data(estr, &len);

    gen.push;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_string");
    gen.add_data(k_string,     str);
    gen.add_data(k_number,     (len: *void));
}



//---------------------------------------------------------------------
//- expr struct
//---------------------------------------------------------------------
export
voidc_internal_make_expr_struct: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    flags = (cmd[0] : int);

    packed = (flags >> 1  : bool);
    export = (flags & 0x1 : bool);

    ast = top - 2;

    ret  = (ast:   *v_ast_expr_t);
    name = (ast+0: *v_ast_expr_t);
    body = (ast+1: *v_ast_stmt_list_t);

    v_ast_make_expr_struct(ret, name, body, packed, export);

    cmd += 1;
    top -= 1;
}

private
gen_expr_struct: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_struct_t);

    name = &obj[0];
    body = &obj[1];

    packed = obj[2];
    export = obj[3];

    gen.visit(name);
    gen.visit(body);

    gen.pop;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_struct");
    gen.add_data(k_number,     ((packed << 1) | export: *void));
}


//---------------------------------------------------------------------
//- expr union
//---------------------------------------------------------------------
export
voidc_internal_make_expr_union: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    export = (cmd[0] : bool);

    ast = top - 2;

    ret  = (ast:   *v_ast_expr_t);
    name = (ast+0: *v_ast_expr_t);
    body = (ast+1: *v_ast_stmt_list_t);

    v_ast_make_expr_union(ret, name, body, export);

    cmd += 1;
    top -= 1;
}

private
gen_expr_union: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_union_t);

    gen.visit(&obj.name);
    gen.visit(&obj.body);

    gen.pop;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_union");
    gen.add_data(k_number,     (obj.export: *void));
}


//---------------------------------------------------------------------
//- expr stmt
//---------------------------------------------------------------------
export
voidc_internal_make_expr_stmt: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 1;

    ret  = (ast: *v_ast_expr_t);
    stmt = (ast: *v_ast_stmt_t);

    v_ast_make_expr_stmt(ret, stmt);
}

private
gen_expr_stmt: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_stmt_t);

    gen.visit(&obj.stmt);

    gen.add_data(k_identifier, &"voidc_internal_make_expr_stmt");
}


//---------------------------------------------------------------------
//- expr block
//---------------------------------------------------------------------
export
voidc_internal_make_expr_block: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    ast = top - 2;

    ret  = (ast:   *v_ast_expr_t);
    slst = (ast+0: *v_ast_stmt_list_t);
    expr = (ast+1: *v_ast_expr_t);

    v_ast_make_expr_block(ret, slst, expr);

    top -= 1;
}

private
gen_expr_block: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_expr_block_t);

    gen.visit(&obj.slst);
    gen.visit(&obj.expr);

    gen.pop;

    gen.add_data(k_identifier, &"voidc_internal_make_expr_block");
}


//---------------------------------------------------------------------
//- operator ...
//---------------------------------------------------------------------
export
voidc_internal_make_operator: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    op = (cmd[0] : *v_ast_expr_t);

    ast = top;

    ret = (ast: *v_ast_expr_t);

    v_copy(ret, op);

    top += 1;
    cmd += 1;
}

private
gen_operator_helper: (gen: &voidc_ast_generator_t, quark: v_quark_t) ~> void
{
    sstr: &v_std_string_t := {};

    v_std_string_set(&sstr, "v_");

    v_std_string_append(&sstr, v_quark_to_string(quark)+2);     //- Skip "v."

    opstr = v_quark_to_string(v_quark_from_string(v_std_string_get(&sstr)));

    gen.push;

    gen.add_data(k_identifier, &"voidc_internal_make_operator");
    gen.add_data(k_identifier, opstr);
}


//---------------------------------------------------------------------
//- operator nullary
//---------------------------------------------------------------------
export
voidc_internal_make_operator_nullary: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    quark = v_quark_from_string((cmd[0] : *const char));

    ast = top - 1;

    ret = (ast: *v_ast_expr_t);
    pay =  ast;

    v_ast_make_operator_nullary(ret, quark, pay);

    cmd += 1;
}

private
gen_operator_nullary: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_operator_nullary_t);

    quark =  obj[0];
    pay   = &obj[1];

    if (v_empty(pay))
    {
        gen_operator_helper(gen, quark);
    }
    else
    {
        gen.visit(pay);

        gen.add_data(k_identifier, &"voidc_internal_make_operator_nullary");
        gen.add_data(k_quark,      (quark: *void));
    }
}


//---------------------------------------------------------------------
//- operator unary
//---------------------------------------------------------------------
export
voidc_internal_make_operator_unary: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    prec  = (cmd[0] : unsigned);
    quark = v_quark_from_string((cmd[1] : *const char));

    ast = top - 1;

    ret = (ast: *v_ast_expr_t);
    pay =  ast;

    v_ast_make_operator_unary(ret, quark, prec, pay);

    cmd += 2;
}

private
gen_operator_unary: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_operator_unary_t);

    quark =  obj[0];
    prec  =  obj[1];
    pay   = &obj[2];

    if (v_empty(pay))
    {
        gen_operator_helper(gen, quark);
    }
    else
    {
        gen.visit(pay);

        gen.add_data(k_identifier, &"voidc_internal_make_operator_unary");
        gen.add_data(k_number,     (prec: *void));
        gen.add_data(k_quark,      (quark: *void));
    }
}


//---------------------------------------------------------------------
//- operator binary
//---------------------------------------------------------------------
export
voidc_internal_make_operator_binary: (cmd: &*const *void, top: &*v_ast_base_t) ~> void
{
    prec_l = (cmd[0] : unsigned);
    prec_r = (cmd[1] : unsigned);
    quark  = v_quark_from_string((cmd[2] : *const char));

    ast = top - 1;

    ret = (ast: *v_ast_expr_t);
    pay =  ast;

    v_ast_make_operator_binary(ret, quark, prec_l, prec_r, pay);

    cmd += 3;
}

private
gen_operator_binary: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    gen = *(vis: *voidc_ast_generator_t);

    void_obj = v_ast_generic_get_object(self);

    obj = *(void_obj: *v_ast_operator_binary_t);

    quark  =  obj[0];
    prec_l =  obj[1];
    prec_r =  obj[2];
    pay    = &obj[3];

    expr: &v_ast_expr_t := {};

    if (v_empty(pay))
    {
        gen_operator_helper(gen, quark);
    }
    else
    {
        gen.visit(pay);

        gen.add_data(k_identifier, &"voidc_internal_make_operator_binary");
        gen.add_data(k_number,     (prec_l: *void));
        gen.add_data(k_number,     (prec_r: *void));
        gen.add_data(k_quark,      (quark: *void));
    }
}


//---------------------------------------------------------------------
export
voidc_internal_ast_repr_helper: (stk_size: size_t, cmd: *const *void, cmd_size: size_t) ~> v_ast_base_t
{
    stk = new v_ast_base_t[stk_size];
    defer delete[] stk;

    for (p: &*const *void := cmd, e = p+cmd_size, s: &*v_ast_base_t := stk; p < e;)
    {
        fun = (*p: *((&*const *void, &*v_ast_base_t) ~> void));

        fun(++p, s);
    }

    ret = v_get_return_value();

    v_copy(&ret, stk+0);
}

//---------------------------------------------------------------------
private
my_compile_ast_repr_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
//printf("my_compile_ast_repr_intrinsic: start\n");
//defer printf("my_compile_ast_repr_intrinsic: stop\n");

    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);        //- Value

    gen: &voidc_ast_generator_t := {};

    gen.visit(arg0);

    v_assert(gen.cur_stk == 1 <= gen.max_stk);

    list = &gen.data_list;

    //-----------------------------------------------------------------
    N = v_list_get_size(list);

    vals = v_malloc(LLVMValueRef, N/2);
    defer v_free(vals);

    builder = v_target_get_builder();

    for (i: &size_t := 0; i < N; i += 2)
    {
        key  = (v_std_any_get_value(intptr_t, v_list_get_item(list, i))   : unsigned);
        data = (v_std_any_get_value(intptr_t, v_list_get_item(list, i+1)) : *void);

        val = vals[i/2];

        flag: &bool := false;

        str: &*const char := undef;
        len: &size_t      := undef;

        switch(key)
        {
        case k_identifier:

            ok = v_obtain_identifier((data: *const char), 0, &val);
            v_assert(ok);

            break;

        case k_number:

            v = LLVMConstInt(v_type_get_llvm_type(intptr_t), (data: intptr_t), 1);
            val := LLVMConstIntToPtr(v, v_type_get_llvm_type(v_pointer_type(v_void_type(), 0)));

            break;

        case k_quark:

            quark = (data: v_quark_t);

            str := v_quark_to_string(quark);
            len := v_quark_to_string_size(quark);

            flag := true;

            break;

        case k_string:

            str := (data: *const char);
            len := (v_std_any_get_value(intptr_t, v_list_get_item(list, i+3)) : size_t);

            flag := true;

            break;
        }

        if (flag)
        {
            str_v = LLVMConstStringInContext(v_target_get_llvm_ctx(), str, (len: unsigned), 0);

            vv = LLVMAddGlobal(v_get_module(), LLVMTypeOf(str_v), "");

            LLVMSetInitializer(vv, str_v);

            LLVMSetLinkage(vv, LLVMPrivateLinkage);

            LLVMSetUnnamedAddress(vv, LLVMGlobalUnnamedAddr);

            LLVMSetGlobalConstant(vv, true);

            val := vv;
        }
    }

    void_ptr = v_pointer_type(v_void_type(), 0);

    arr_v = LLVMConstArray(v_type_get_llvm_type(void_ptr), vals, (N/2 : unsigned));

    vv = LLVMAddGlobal(v_get_module(), LLVMTypeOf(arr_v), "");

    LLVMSetInitializer(vv, arr_v);

    LLVMSetLinkage(vv, LLVMPrivateLinkage);

    LLVMSetUnnamedAddress(vv, LLVMGlobalUnnamedAddr);

    LLVMSetGlobalConstant(vv, true);

    expr: &v_ast_expr_t[3]   := {};
    elst: &v_ast_expr_list_t := {};

    v_ast_make_expr_integer(expr+0, gen.max_stk);

    v_ast_make_expr_compiled(expr+1, v_pointer_type(void_ptr, 0), vv);

    v_ast_make_expr_integer(expr+2, N/2);

    v_make_list(&elst, expr, 3);

    v_ast_make_expr_identifier(expr+0, "voidc_internal_ast_repr_helper");

    v_ast_make_expr_call(expr+0, expr+0, &elst);

    v_ast_accept_visitor(expr+0, vis);
}


//---------------------------------------------------------------------
private
gen_visitor: &voidc_visitor_t := {};

block
{
    vis = &gen_visitor;

    voidc_make_visitor(vis);

    q = v_quark_from_string;

    voidc_visitor_set_method(vis, vis, q("unit"),                gen_unit,              0);
    voidc_visitor_set_method(vis, vis, q("ast.generic_list"),    gen_generic_list,      0);     //- Sic !!!
    voidc_visitor_set_method(vis, vis, q("defn_list_unit"),      gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_defn_list"),      gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_fun_defn"),       gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_var_defn"),       gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_val_defn"),       gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_ccif_list"),      gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_struct_defn"),    gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_spec_fun_defn"),  gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_spec_fun_renm"),  gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_union_defn"),     gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_stmt_init"),      gen_unit_stmt_init,    0);
    voidc_visitor_set_method(vis, vis, q("unit_stmt_term"),      gen_unit_stmt_term,    0);
    voidc_visitor_set_method(vis, vis, q("unit_namespace_open"), gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_defn_close"),     gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("unit_defn_using"),     gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("stmt_list"),           gen_stmt_list,         0);
    voidc_visitor_set_method(vis, vis, q("stmt"),                gen_stmt,              0);
    voidc_visitor_set_method(vis, vis, q("stmt_if_then_else"),   gen_stmt_if_then_else, 0);
    voidc_visitor_set_method(vis, vis, q("stmt_block"),          gen_stmt_block,        0);
    voidc_visitor_set_method(vis, vis, q("stmt_loop"),           gen_stmt_loop,         0);
    voidc_visitor_set_method(vis, vis, q("stmt_defer"),          gen_stmt_defer,        0);
    voidc_visitor_set_method(vis, vis, q("stmt_switch"),         gen_stmt_switch,       0);
    voidc_visitor_set_method(vis, vis, q("case_list"),           gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("case_block"),          gen_case_block,        0);
    voidc_visitor_set_method(vis, vis, q("stmt_ccif_list"),      gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("expr_list"),           gen_expr_list,         0);
    voidc_visitor_set_method(vis, vis, q("expr_call"),           gen_expr_call,         0);
    voidc_visitor_set_method(vis, vis, q("expr_identifier"),     gen_expr_identifier,   0);
    voidc_visitor_set_method(vis, vis, q("expr_integer"),        gen_expr_integer,      0);
    voidc_visitor_set_method(vis, vis, q("expr_string"),         gen_expr_string,       0);
    voidc_visitor_set_method(vis, vis, q("expr_char"),           gen_expr_char,         0);
    voidc_visitor_set_method(vis, vis, q("expr_struct"),         gen_expr_struct,       0);
    voidc_visitor_set_method(vis, vis, q("expr_union"),          gen_expr_union,        0);
    voidc_visitor_set_method(vis, vis, q("expr_stmt"),           gen_expr_stmt,         0);
    voidc_visitor_set_method(vis, vis, q("expr_block"),          gen_expr_block,        0);
    voidc_visitor_set_method(vis, vis, q("expr_ccif_list"),      gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("br_item_list"),        gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("cc_message"),          gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("cc_do"),               gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("cc_assert"),           gen_generic_list,      0);
    voidc_visitor_set_method(vis, vis, q("operator_nullary"),    gen_operator_nullary,  0);
    voidc_visitor_set_method(vis, vis, q("operator_unary"),      gen_operator_unary,    0);
    voidc_visitor_set_method(vis, vis, q("operator_binary"),     gen_operator_binary,   0);
    voidc_visitor_set_method(vis, vis, q("projection_payload"),  gen_generic_list,      0);
}


//---------------------------------------------------------------------
//- Grammar actions ...
//---------------------------------------------------------------------
private
mk_parse_any_grammar_action: (ret: *v_std_any_t, *void, any: *v_std_any_t, size_t) ~> void
{
    id = v_std_any_get_pointer(v_std_string_t, any);

    v_peg_parse(ret, v_quark_from_string(v_std_string_get(id)));
}

//---------------------------------------------------------------------
private
mk_quote_ast_grammar_action: (ret: *v_std_any_t, *void, any: *v_std_any_t, size_t) ~> void
{
//printf("mk_quote_ast_grammar_action: start\n");
//defer printf("mk_quote_ast_grammar_action: stop\n");

    ast = v_ast_std_any_get_base(any);
    if (!ast)   return;

    //-----------------------------------------------------------------
    expr: &v_ast_expr_t := {};
    elst: &v_ast_expr_list_t := {};

    v_make_list(&elst, (ast: *v_ast_expr_t));

    v_ast_make_expr_identifier(&expr, "v.compile_ast_repr");

    v_ast_make_expr_call(&expr, &expr, &elst);

    v_std_any_set_pointer(ret, &expr);
}


//---------------------------------------------------------------------
export
v_get_ast_generator_visitor: () ~> *voidc_visitor_t
{
    return  &gen_visitor;
}

//---------------------------------------------------------------------
//- Enable generating AST
//---------------------------------------------------------------------
export
voidc_enable_generating_ast_compiler: () ~> void
{
    v_return_if(v_find_constant_q(enabled_q, 0, 0));

    v_add_constant_q(enabled_q, v_void_type(), 0);

    v_add_intrinsic("v.compile_ast_repr", my_compile_ast_repr_intrinsic, 0);
}

//---------------------------------------------------------------------
export
voidc_enable_generating_ast: () ~> void
{
    voidc_enable_generating_ast_compiler();

    gr0 = v_peg_get_grammar();

    v_return_if_not(gr0);
    v_return_if(v_peg_grammar_get_parser(gr0, "parse_any", 0));

    //--------------------------------------------------------------
    grammar gr0
    {
    actions:
        mk_parse_any = mk_parse_any_grammar_action;
        mk_quote_ast = mk_quote_ast_grammar_action;

    parsers:
        parse_any = '{' <'\'' i:identifier (![\n\r\t\'] .)* '\''> _ a:{ mk_parse_any(i) } _ $1 '}'  { a };

        prim =+ a:parse_any     { mk_quote_ast(a) };
    }
}


//=====================================================================
{   voidc_unit_end_module(); }



{   v_import("level-00");

    v_import("level-01/function_hack.void");

    v_import("level-01/grammar.void");
}

{   v_import("printf.void");
}


//---------------------------------------------------------------------
{   voidc_enable_function_hack();
    voidc_enable_statement_grammar();
}



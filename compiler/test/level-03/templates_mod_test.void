{   v_import("level-00");
    v_import("level-01");
    v_import("level-02");

    v_import("level-03/intrinsics_derive.void");
    v_import("level-03/local_objects.void");
    v_import("level-03/heap_objects.void");
    v_import("level-03/global_objects.void");
    v_import("level-03/coercions.void");
    v_import("level-03/namespaces.void");
    v_import("level-03/generics_etc.void");
    v_import("level-03/generating_ast.void");
    v_import("level-03/macros.void");
    v_import("level-03/templates.void");

    v_import("printf.void");
}

{   v_enable_level_01();
    v_enable_level_02();

    voidc_enable_intrinsics_derive();
    voidc_enable_local_objects();
    voidc_enable_heap_objects();
    voidc_enable_global_objects();
    voidc_enable_coercions();
    voidc_enable_namespaces();
    voidc_enable_generics_etc();
    voidc_enable_generating_ast();
    voidc_enable_macros();
    voidc_enable_templates();
}

//---------------------------------------------------------------------
{   q_ref = v_reference_type(v_quark_t, 0);

    q = v_quark_ptr_from_string;

    v_add_symbol("q_static_type_t", q_ref, q("v_static_type_t"));
}


//=====================================================================
{   voidc_unit_begin_module("templates_mod_test_module"); }


//---------------------------------------------------------------------
private
map_op_braces_intrinsic: (aux: *void, vis: *voidc_visitor_t, self: *v_ast_base_t,
                           arg_ptrs: **v_ast_expr_t, arg_count: unsigned
                          ) ~> void
{
//printf("list_op_braces_intrinsic: start\n");
//defer printf("list_op_braces_intrinsic: stop\n");

    tr: &*v_type_t := v_get_result_type();

    is_reference = v_type_is_reference(tr);

    addr_sp: &unsigned := undef;

    if (is_reference)
    {
        addr_sp := v_type_refptr_get_address_space(tr);         //- Sic!
        tr      := v_type_refptr_get_element_type(tr);          //- Sic!
    }

    vr: &LLVMValueRef := v_get_result_value();

    if (vr == 0)  vr := v_make_temporary(tr, 0);

    list: &v_ast_stmt_list_t :=
    {'stmt_list'

         my_any: &v_std_any_t := {};

         #define my_step: (m, kv)
         {'stmt_list'

             v_std_any_set_value(&my_any, kv[1]);

             v_map_insert(m, m, (kv[0]: intptr_t), &my_any);

         'stmt_list'}

    'stmt_list'};

    expr: &v_ast_expr_t[2] := {};

    v_ast_make_expr_compiled(expr+0, v_pointer_type(v_util_map_t, 0), vr);

    typ = (aux: *v_type_t);

    my_step_q = v_quark_from_string("my_step");

    stmt: &v_ast_stmt_t := {};

    for (i: &int := 0; i < arg_count; ++i)
    {
        v_reset_result();

        v_set_result_type(typ);

        v_ast_accept_visitor(arg_ptrs[i], vis);

        kv = v_get_result_value();

        v_ast_make_expr_compiled(expr+1, typ, kv);

        v_ast_make_stmt_call(&stmt, 0, my_step_q, expr, 2);

        v_list_append(&list, &list, &stmt);
    }

    v_ast_make_stmt_block(&stmt, &list, false);

    v_reset_result();

    v_ast_accept_visitor(&stmt, vis);

    if (is_reference) v_set_result_type(v_reference_type(tr, addr_sp));
    else              v_set_result_type(tr);

    v_set_result_value(vr);
}

//---------------------------------------------------------------------
private
register_map_op_braces_intrinsic: (*void, vis: *voidc_visitor_t, self: *v_ast_base_t) ~> void
{
    args = v_ast_expr_call_get_arg_list((self: *v_ast_expr_t));

    arg0 = v_list_get_item(args, 0);        //- Map type
    arg1 = v_list_get_item(args, 1);        //- Key type
    arg2 = v_list_get_item(args, 2);        //- Value type

    static_type_t = v_find_type_q(q_static_type_t);

    v_reset_result();

    v_set_result_type(static_type_t);

    v_ast_accept_visitor(arg0, vis);

    map_type = (v_get_result_value() : *v_type_t);

    v_reset_result();

    v_set_result_type(static_type_t);

    v_ast_accept_visitor(arg1, vis);

    key_type = (v_get_result_value() : *v_type_t);

    v_reset_result();

    v_set_result_type(static_type_t);

    v_ast_accept_visitor(arg2, vis);

    val_type = (v_get_result_value() : *v_type_t);

    sstr: &v_std_string_t := {};

    v_std_string_set(&sstr, "my.map_op_braces-(");

    voidc_internal_std_string_append_type(&sstr, key_type);

    v_std_string_append(&sstr, ", ");

    voidc_internal_std_string_append_type(&sstr, val_type);

    v_std_string_append(&sstr, ")");

    iname = v_std_string_get(&sstr);

    v_add_overload("v.op_braces", map_type, iname);

    typ: &(*v_type_t)[2] := { key_type, val_type };

    elt_type = v_struct_type(typ, 2, false);

    v_add_intrinsic(iname, map_op_braces_intrinsic, elt_type);      //- Sic!
}


//---------------------------------------------------------------------
export
namespace .my {


//---------------------------------------------------------------------
#define map: [](K: v_static_type_t, T: v_static_type_t) ~> v_static_type_t  =
{
    MT = v_generic(".my.map", T[K, T]);

    #template [*, MT, K, T]()
    {
        private impl_t = v_util_map_t;

        #do (v_set_implementation_type(MT, impl_t))

        private alwaysinline
        impl: (s: &MT) ~> &impl_t  =  *(&s : *impl_t);

        inlinehint
        (v_initialize(_)): (p: *MT, n: size_t) ~> void
        {
            v_initialize(&impl(*p), n);

            for (i: &int := 0; i < n; ++i)  v_make_map(&impl(p[i]));
        }

        alwaysinline
        (v_terminate(_)): (p: *MT, n: size_t) ~> void
        {
            v_terminate(&impl(*p), n);
        }

        alwaysinline
        (v_copy(_)): (d: *MT, s: *const MT, n: size_t) ~> void
        {
            v_copy(&impl(*d), &impl(*s), n);
        }

        alwaysinline
        (v_move(_)): (d: *MT, s: *MT, n: size_t) ~> void
        {
            v_move(&impl(*d), &impl(*s), n);
        }

        //-------------------------------------------------------------
        alwaysinline
        (_:=_): (d: &MT, s: MT) ~> &MT  =
        {
            v_copy(&d, &s);

            d
        };

        //-------------------------------------------------------------
        #do (register_map_op_braces(MT, K, T))

        inlinehint
        (_[]): (m: MT, i: K) ~> T  =
        {
            a = v_map_find(&impl(*&m), (i: intptr_t));
            v_assert(a);

            v_std_any_get_value(T, a)
        };

        inlinehint
        (_.insert()): (m: MT, i: K, v: T) ~> MT
        {
            a: &v_std_any_t := {};

            v_std_any_set_value(&a, v);

            v_map_insert(&impl(v_get_return_value()), &impl(*&m), (i: intptr_t), &a);
        }

        inlinehint
        (_.erase()): (m: MT, i: K) ~> MT
        {
            v_map_erase(&impl(v_get_return_value()), &impl(*&m), (i: intptr_t));
        }

        alwaysinline
        (_.size): (m: MT) ~> size_t  =  v_map_get_size(&impl(*&m));

    }   //- #template

    MT
};


//---------------------------------------------------------------------
enable_map_effort: (*void) ~> void
{
    v_add_intrinsic("register_map_op_braces", register_map_op_braces_intrinsic, 0);
}


//---------------------------------------------------------------------
}   //- namespace .my


//=====================================================================
{   voidc_unit_end_module(); }


//---------------------------------------------------------------------
{   v_export_effort(my.enable_map_effort, 0); }



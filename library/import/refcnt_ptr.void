{ voidc_import("libvoidc.void"); }
{
    voidc_set_level_limit(LIBVOIDC_LIMIT_LEVEL_03);

    voidc_make_header("refcnt_ptr");
}
//---------------------------------------------------------------------
{
    v_export_import("type_traits.void");
}


//---------------------------------------------------------------------
namespace .std {


//---------------------------------------------------------------------
#define refcnt_ptr: [](T: v_static_type_t) ~> v_static_type_t  =
{
    pt = v_generic(".std.refcnt_ptr", t(T));

    _instantiate_refcnt_ptr(pt, T);

    pt
};

//---------------------------------------------------------------------
#template _instantiate_refcnt_ptr: [](PT: v_static_type_t, T: v_static_type_t)
{
    private is_incomplete_array = T.is_incomplete_array;

    #if (is_incomplete_array)

        private ET = T.element_type;

        private ET_size = 1;

        private RT = ET;

        private
        #define check_ET_size: ()
        {'unit_defn_list'

            #if (RT.is_array)

                private ET_size = ET_size * RT.length;

                private RT = RT.element_type;

                #do (check_ET_size())           //- Kinda, TODO...

            #endif

        'unit_defn_list'}

        #do (check_ET_size())

        private is_object = RT.is_special(v_initialize);

    #else

        private ET = T;

    #endif

    //-------------------------------------------------------------
    #do (v_set_implementation_type(PT, *ET))

    inlinehint
    (v_initialize(_)): (d: *PT, n: size_t) ~> void
    {
        .memset: (*void, int, size_t) ~> *void;

        .memset(d, 0, n*sizeof(PT));
    }

    //-------------------------------------------------------------
    private
    namespace detail
    {
        alwaysinline
        impl: (s: &PT) ~> &*ET  =  *(&s : **ET);

        #if (is_incomplete_array)

            #if (is_object)

                struct data_t
                {
                    count: size_t;
                    size:  size_t;

                    data: ET[0];
                };

            #else

                struct data_t
                {
                    count: size_t;

                    data: ET[0];
                };

            #endif

        #else

            struct data_t
            {
                count: size_t;

                data: T;
            };

            inlinehint
            (v_initialize(_)): (*data_t) ~> void  =  derive;

            inlinehint
            (v_terminate(_)): (*data_t) ~> void  =  derive;

        #endif

        alwaysinline
        get_data: (p: &PT) ~> &data_t  =
        {
            v_assert(impl(p));

            *((impl(p): *char) - (&(0: *data_t)->data : intptr_t) : *data_t)
        };

        inlinehint
        inc: (p: &PT) ~> void
        {
            if (!impl(p))  return;

            d = get_data(p);

            ++d.count;
        }

        inlinehint
        dec: (p: &PT) ~> void
        {
            if (!impl(p))  return;

            d = get_data(p);

            if (--d.count == 0)
            {
                #if (is_incomplete_array)

                    #if (is_object)

                        v_terminate((&d.data : *RT), d.size);       //- ...

                    #endif

                    v_aligned_free(&d);

                #else

                    delete &d;

                #endif
            }
        }

    }   //- namespace detail

    //-------------------------------------------------------------
    #if (is_incomplete_array)

        inlinehint
        create: (n: size_t) ~> PT
        {
            ret = v_get_return_value();

            detail.dec(ret);            //- Sic !!!

            b_size = (&(0: *detail.data_t)->data[n] : size_t);

            align = alignof(detail.data_t);

            b_size = (b_size + (align-1))/align * align;

            d = *(v_aligned_alloc(align, b_size) : *detail.data_t);

            d.count := 1;

            #if (is_object)

                n_size = ET_size * n;

                d.size := n_size;

                v_initialize((&d.data : *RT), n_size);

            #endif

            detail.impl(ret) := (&d.data : *ET);
        }

    #else

        inlinehint
        create: () ~> PT
        {
            ret = v_get_return_value();

            detail.dec(ret);            //- Sic !!!

            dp = new detail.data_t {{1}};

            detail.impl(ret) := &dp->data;
        }

    #endif

    //-------------------------------------------------------------
    inlinehint
    (v_terminate(_)): (d: *PT) ~> void
    {
        detail.dec(*d);
    }

    inlinehint
    (v_copy(_)): (d: *PT, s: *const PT) ~> void
    {
        detail.dec(*d);
        detail.inc(*s);

        detail.impl(*d) := detail.impl(*s);
    }

    inlinehint
    (v_move(_)): (d: *PT, s: *PT) ~> void
    {
        detail.dec(*d);

        detail.impl(*d) := detail.impl(*s);
        detail.impl(*s) := 0;
    }

    alwaysinline
    (v_empty(_)): (p: *PT) ~> bool  =  detail.impl(*p) == 0;

    //-------------------------------------------------------------
    alwaysinline
    (_.get): (p: PT) ~> *ET  =  detail.impl(*&p);

    #if (is_incomplete_array)

        alwaysinline
        (_[]): (p: PT, i: intptr_t) ~> &ET  =  p.get[i];

    #else

        alwaysinline
        (*_): (p: PT) ~> &T  =  *p.get;

        alwaysinline
        (_->): (p: PT) ~> *T  =  p.get;

    #endif

    //-------------------------------------------------------------
    alwaysinline
    (_:=_): (d: &PT, s: PT) ~> &PT  =
    {
        v_copy(&d, &s);

        d
    };

    //-------------------------------------------------------------
    alwaysinline
    (_.use_count): (p: PT) ~> size_t  =  detail.get_data(*&p).count;

}   //- #template


//---------------------------------------------------------------------
#define make_refcnt: [](T: v_static_type_t, n = void) ~> refcnt_ptr(T)  =
{
    n_defined = !(typeof(n) == v_static_type_t  &&  n == void);

    #if (T.is_incomplete_array)

        #if (n_defined)   refcnt_ptr(T).create(n)
        #else             #fail ("???")
        #endif

    #else

        #if (n_defined)   #fail ("???")
        #else             refcnt_ptr(T).create()
        #endif

    #endif
};


//---------------------------------------------------------------------
}   //- namespace .std


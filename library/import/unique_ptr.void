{ voidc_import("libvoidc.void"); }
{
    voidc_set_level_limit(LIBVOIDC_LIMIT_LEVEL_03);

    voidc_make_header("unique_ptr");
}
//---------------------------------------------------------------------
{
    v_export_import("type_traits.void");
}


//---------------------------------------------------------------------
namespace .std {


//---------------------------------------------------------------------
#define unique_ptr: [](T: v_static_type_t) ~> v_static_type_t  =
{
    pt = v_generic(".std.unique_ptr", t(T));

    _instantiate_unique_ptr(pt, T);

    pt
};

//---------------------------------------------------------------------
#template _instantiate_unique_ptr: [](PT: v_static_type_t, T: v_static_type_t)
{
    private is_incomplete_array = T.is_incomplete_array;

    #if (is_incomplete_array)   private ET = T.element_type;
    #else                       private ET = T;
    #endif

    #do (v_set_implementation_type(PT, *ET))

    private alwaysinline
    impl: (s: &PT) ~> &*ET  =  *(&s : **ET);

    //-------------------------------------------------------------
    inlinehint
    (v_initialize(_)): (d: *PT, n: size_t) ~> void
    {
        .memset: (*void, int, size_t) ~> *void;

        .memset(d, 0, n*sizeof(PT));
    }

    alwaysinline
    (_.get): (p: PT) ~> *ET  =  impl(*&p);

    inlinehint
    (v_terminate(_)): (sp: *PT) ~> void
    {
        if (p = sp->get)
        {
            #if (is_incomplete_array)   delete[] p;
            #else                       delete p;
            #endif
        }
    }

    alwaysinline
    (_.release): (sp: &PT) ~> *ET  =
    {
        r = sp.get;

        impl(sp) := 0;

        r
    };

    alwaysinline
    (_.reset()): (sp: &PT, p: *ET) ~> void
    {
        v_terminate(&sp);

        impl(sp) := p;
    }

    #define
    (v_copy(_)): [](d: *PT, s: *const PT, n: size_t)
    {'stmt'
        #error ("Not supported!")
    'stmt'}

    inlinehint
    (v_move(_)): (d: *PT, s: *PT) ~> void
    {
        d->reset(s->release);
    }

    alwaysinline
    (v_empty(_)): (p: *const PT) ~> bool  =  impl(*p) == 0;

    //-------------------------------------------------------------
    #if (is_incomplete_array)

        inlinehint
        create: (n: size_t) ~> PT
        {
            v_get_return_value().reset(new ET[n]);
        }

        alwaysinline
        (_[]): (p: PT, i: intptr_t) ~> &ET  =  p.get[i];

    #else

        inlinehint
        create: () ~> PT
        {
            v_get_return_value().reset(new ET);
        }

        alwaysinline
        (*_): (p: PT) ~> &T  =  *p.get;

        alwaysinline
        (_->): (p: PT) ~> *T  =  p.get;

     #endif

    //-------------------------------------------------------------
    alwaysinline
    (_:=_): (d: &PT, s: &PT) ~> &PT  =
    {
        d.reset(s.release);

        d
    };

}   //- #template


//---------------------------------------------------------------------
#define make_unique: [](T: v_static_type_t, n = void) ~> unique_ptr(T)  =
{
    n_defined = !(typeof(n) == v_static_type_t  &&  n == void);

    #if (T.is_incomplete_array)

      #if (n_defined)   unique_ptr(T).create(n)
      #else             #fail ("???")
      #endif

    #else

      #if (n_defined)   #fail ("???")
      #else             unique_ptr(T).create()
      #endif

    #endif
};


//---------------------------------------------------------------------
}   //- namespace .std

